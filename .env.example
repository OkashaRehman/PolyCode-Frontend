# Local dev — used by `npm start` on http://localhost:3000
REACT_APP_API_URL=http://localhost:5000/api

# Google Sign-In (Continue with Google) — same Web client ID as backend GOOGLE_CLIENT_ID
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
# Authorized JavaScript origins must include http://localhost:3000
REACT_APP_GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# PolyGuard — rules in browser + Hugging Face ML model
REACT_APP_POLYGUARD_REMOTE_AUGMENT=true
REACT_APP_POLYGUARD_API_URL=https://muhammadsaadamin-polyguard-api.hf.space

# PolyMentor assistant is served by the Express backend at REACT_APP_API_URL (/api/chat/assistant).
# Set GROQ_API_KEY on the backend (see backend/.env.example).

# QuantumChat dock (sign-in / keys / chats) — same product as Boolforge Circuits
# "Open full QuantumChat" link target — default: https://chat.quantumlogicslimited.com/chat
# REACT_APP_QUANTUMCHAT_URL=https://chat.quantumlogicslimited.com/chat
# In `npm start`, the dock uses a same-origin /qc-api proxy (see setupProxy.js)
# so localhost works even before the QuantumChat backend's CORS allowlist is updated.
# REACT_APP_QUANTUMCHAT_API_URL=https://quantum-chat-backend-six.vercel.app

# Production (Vercel frontend) — also set in Vercel → Settings → Environment Variables
# REACT_APP_API_URL=https://poly-code-backend.vercel.app/api